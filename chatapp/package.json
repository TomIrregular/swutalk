{
  "name": "realtime-chat",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "jest",
    "plato:prepare-views": "node scripts/extract-view-scripts.js",
    "plato": "npm run plato:prepare-views && plato -d report \"controllers/**/*.js\" \"models/**/*.js\" \"report/.tmp-view-scripts/**/*.js\" \"app.js\"",
    "performance": "clinic doctor --dest report --on-port \"npm run loadtest:routes\" -- node app.js",
    "loadtest": "autocannon -c 10 -d 10 http://localhost:3000/ --json > report/loadtest.json",
    "loadtest:routes": "node -e \"require('fs').mkdirSync('report',{recursive:true})\" && autocannon -c 10 -d 10 http://localhost:3000/ --json > report/loadtest-home.json && autocannon -c 10 -d 10 http://localhost:3000/setup-profile --json > report/loadtest-setup-profile.json && autocannon -c 10 -d 10 http://localhost:3000/chat --json > report/loadtest-chat.json"
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "html",
      "text",
      "text-summary",
      "cobertura"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results/jest"
        }
      ]
    ]
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "clinic": "^13.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^16.0.0",
    "plato": "^1.7.0"
  }
}
