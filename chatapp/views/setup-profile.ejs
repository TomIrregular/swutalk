<!DOCTYPE html>
<html>
<head>
    <title>Complete Profile - SWUTalk</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Noto+Sans+Thai:wght@100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap');
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #f5f5f5;
            min-height: 100vh;
            background: url('/res/swutalk.png') no-repeat center center fixed;
            background-size: cover;
            width: 100%;
            position: relative;
        }
        .container {
            display: flex;
            height: 100vh;
            align-items: center;
            justify-content: center;
        }
        .card{
            background-color: rgba(255, 255, 255, 0.7);
            border:1px solid rgba(0, 0, 0, 0.1) ; 
            padding: 20px;
            border-radius: 16px;
            backdrop-filter: blur(13px);
            box-shadow:
             rgba(50, 50, 93, 0.25) 0px 13px 27px -5px,
             rgba(0, 0, 0, 0.5) 0px 8px 16px -8px;
            width: 400px;
            height: 380px;
        }
        .container-card{
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 100%;
        }
        /*SWU TALK*/
        .container-card h1 {
            font-size: 36px;
            font-family:  "Open Sans", sans-serif;
            font-weight: 700;
            margin-bottom: 20px;
            color: #D02752;
        }
        /*Complete Your Profile*/
        .container-card h2 {
            font-family:  "Open Sans", sans-serif;
            font-weight: 700;
            font-size: 24px;
            margin-bottom: 10px;
            color:#D02752;
        }
        /*Please choose a username*/
        .container-card p {
            font-size: 16px;
            font-family: "Open Sans", sans-serif;
            font-weight: 700;
            margin-bottom: 20px;
            color:#111F35;
        }
        .container-card button {
            justify-content: center;
            font-size: 16px;
            width: 300px;
            color: white;
            font-family: "Open Sans", sans-serif;
            font-weight: 400;
            padding: 10px 20px;
            margin-bottom: 20px;
            margin-top: 20px;
            margin-left: 30px;
            text-align: center;
            background-color: #D02752;
            border-radius: 30px;
            border: 2px solid #D02752; 
            cursor: pointer;
            transition: all 0.5s ease;
        }
        .container-card button:hover{
            text-align: center;
            width: 300px;
            background-color: rgba(255, 255, 255, 0.6);
            color: #D02752;
        }
        /*username*/
        .container-card h3 {
            font-family: "Open Sans", sans-serif;
            font-weight: 400;
            font-size: 20px;
            margin-bottom: 10px;
            color:#D02752;
        }
        .container-card input {
            width: 80%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ccc;
            border-radius: 20px;
            font-size: 16px;
            font-family: "Open Sans", sans-serif;
            font-weight: 700;
            color: #D02752;
        }
        .container-card input:focus {
            outline: 2px solid #D02752;
            color: #D02752;

        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="container-card">
                <h1>SWUTALK</h1>
                <form action="/setup-profile" method="POST">
                    <h2>Complete your profile</h2>
                    <p>Please choose a username.</p>
                    <h3><b>Username : </b></h3>
                    <input type="text" name="username" placeholder="Enter your username" required>
                    <button type="submit">Save and Continue</button>
                </form>
            </div>
        </div>
    </div>
    
</body>
</html>
