<!DOCTYPE html>
<html>
<head>
    <title>Chat Room</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Noto+Sans+Thai:wght@100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap');
        body { margin: 0; 
            padding: 20px; 
            display: flex; 
            gap: 20px;
            background: url('/res/background_chat.png') no-repeat center center fixed;
            background-size: cover;
            width: 100%;
            position: relative; 
        }
        .main-wrapper {
            display: flex;
            gap: 20px;
            align-items: flex-start; /* Keeps the sidebar from stretching to the floor */
            max-width: 1120px;       /* 900px (chat) + 200px (sidebar) + 20px (gap) */
            margin: 0 auto;          /* Centers the whole app on the screen */
        }
        .chat-container { 
            flex: 1;
            color: #D02752;
        }
        .chat-container h2 {
            font-family: "Open Sans", sans-serif;
            font-weight: 700;
        }
        .users-sidebar { 
            width: 200px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 16px;
            backdrop-filter: blur(13px);
            padding: 10px;
            height: fit-content;
        }
        .users-sidebar input {
            border: 1px solid #8A244B;
            border-radius: 16px;
            padding: 10px;
            margin-bottom: 10px;
            font-family: "Open Sans", sans-serif;
        }
        .users-sidebar input:focus {
            outline: 1px solid #D02752;
            color: #D02752;
        }
        .users-sidebar h3 { 
            font-family: "Open Sans", sans-serif;
            margin-top: 0; 
            color: #D02752;
        }
        .user-item { 
            font-family: "Open Sans", sans-serif;
            padding: 6px 0px 6px 10px; 
            margin: 2px 0; 
            background: #8A244B; 
            border-radius: 8px;
            color: white;}
        #messages { 
            height: 400px; 
            width: 900px;
            border: 1px solid #ccc; 
            border-radius: 6px;
            overflow-y: scroll; 
            padding: 10px; 
            margin-bottom: 10px; 
            backdrop-filter: blur(20px);
            background-color: rgba(255, 255, 255, 0.7);
        }
        #messages::-webkit-scrollbar {
            width: 8px;
        }
        #message::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }
        #message::-webkit-scrollbar-thumb:hover {
            background: #D02752;
        }
        #messages::-webkit-scrollbar-thumb {
            background: #8A244B;
            border-radius: 4px;
        }
        .message { 
            font-family: "Open Sans", sans-serif;
            margin: 5px 0;
            color:#111F35;
         }
        .username { 
            font-family: "Open Sans", sans-serif;
            font-weight: bold; 
            color: #D02752; }
        .time { 
            font-family: "Open Sans", sans-serif;
            color: #666; 
            font-size: 0.6em; 
        }
        #messageForm { 
            display: flex;
        
        }
        #messageInput,#searchInput { flex: 1; padding: 10px; }
        #messageInput{
            border: 1px solid #8A244B;
            border-radius: 16px;
            padding: 10px;
            margin-bottom: 10px;
            font-family: "Open Sans", sans-serif;
            font-weight: 400;
            max-width: 900px;
        }
        #messageInput:focus {
            outline: 1px solid #D02752;
            color: #D02752;
        }
        button {
            min-width: 80px;
            height: 40px;
            background: #8A244B; 
            color: white; 
            border: 3px solid #8A244B; 
            cursor: pointer; 
            font-family: "Open Sans", sans-serif;
            font-weight: 700;
            border-radius: 16px;
            margin-left: 10px;
            transition: all 0.3s ease;
        }
        button:hover { 
            background: rgba(255, 255, 255, 0.5);
            color: #8A244B; 
        }
    </style>
</head>
<body>
    <div class="main-wrapper">
        <!-- Chat -->
        <div class="chat-container">
            <h2>Chat Room - Welcome <%= username %>!</h2>
            <div id="messages"></div>
            <form id="messageForm">
                <input id="messageInput" type="text" placeholder="Type your message..." required>
                <button type="submit">Send</button>
            </form>
        </div>

        <!-- Search + List -->
        <div class="users-sidebar">
            <input id="searchInput" type="text" placeholder="Search..." required style="margin-bottom: 10px;">
            <h3>Active Users</h3>
            <div id="usersList"></div>
        </div>
    </div>
    
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Constants
        const socket = io();
        const username = '<%= username %>';
        const messages = document.getElementById('messages');
        const messageForm = document.getElementById('messageForm');
        const messageInput = document.getElementById('messageInput');
        const usersList = document.getElementById('usersList');
        const searchInput = document.getElementById('searchInput');

        // Join + Disconnect Listener?
        socket.emit('join', username);

        window.addEventListener('beforeunload', () => {
            socket.disconnect();
        });

        // Message sent listener
        messageForm.addEventListener('submit', (e) => {
            e.preventDefault();
            if (messageInput.value) {
                socket.emit('chat message', { message: messageInput.value });
                messageInput.value = '';
            }
        });
        
        // Search listener
        searchInput.addEventListener('input', (e) => {
            const searchKey = e.target.value.toLowerCase();
            const allMessages = messages.getElementsByClassName('message');

            Array.from(allMessages).forEach((msg) => {
                const usernameText = msg.querySelector('.username').textContent.toLowerCase();
                const messageText = msg.querySelector('.body').textContent.toLowerCase();
                const dateText = msg.querySelector('.time').textContent.toLowerCase();
                let textChecker = false;
                
                if (searchKey.startsWith('"@') && searchKey.endsWith('"')) {
                    const targetUser = searchKey.slice(2,-1);
                    textChecker = usernameText.includes(targetUser);
                } 
                else if (searchKey.startsWith('"date:') && searchKey.endsWith('"')) {
                    const targetDate = searchKey.slice(6,-1);
                    textChecker = dateText.includes(targetDate);
                }
                else {
                    textChecker = messageText.includes(searchKey);
                }

                msg.style.display = textChecker ? 'block' : 'none';
            });
        });

        // Chat stuff
        socket.on('chat message', (data) => {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message';
            messageDiv.innerHTML = `<span class="username">${data.username}:</span> <span class="body">${data.message}</span> <span class="time">${data.time}</span>`;
            messages.appendChild(messageDiv);
            messages.scrollTop = messages.scrollHeight;
        });

        socket.on('user joined', (username) => {
            const messageDiv = document.createElement('div');
            messageDiv.innerHTML = `<em>${username} joined the chat</em>`;
            messages.appendChild(messageDiv);
        });

        socket.on('user left', (username) => {
            const messageDiv = document.createElement('div');
            messageDiv.innerHTML = `<em>${username} left the chat</em>`;
            messages.appendChild(messageDiv);
        });

        // User list manager
        socket.on('users update', (users) => {
            usersList.innerHTML = '';
            users.forEach(user => {
                const userDiv = document.createElement('div');
                userDiv.className = 'user-item';
                userDiv.textContent = user;
                usersList.appendChild(userDiv);
            });
        });
    </script>
</body>
</html>
