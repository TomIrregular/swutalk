<!DOCTYPE html>
<html>
<head>
    <title>Welcome to SWUTalk!</title>
    <style>
        *{
            margin: 0;
            padding: 0;
        }
        body { font-family: Arial, sans-serif; max-width: 400px; margin: 100px auto; padding: 20px; }
        input { width: 100%; padding: 10px; margin: 10px 0; box-sizing: border-box; }
        button { width: 100%; padding: 10px; background: #007bff; color: white; border: none; cursor: pointer; }
        .card{
            background-color: white;
            border:black 2px; 
            border-radius: 8px;
            width: 400px;
            height: 400px;
            box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
            padding:20px;
            
            h3{
                margin-top: 20px;
                
            }
            p{
                margin-top: 20px;
            }
            input{
                margin-top: 20px;
                border-radius: 4px;
            }
            button{
                border-radius: 20px;
                background-color: #FB7A7A;
                margin-top:20px;
            }
        }
    </style>
</head>
<body>
    <h1 style="color: #FB7A7A;">SWUTALK</h1>
    <div class="card">
        <h2 style="margin-bottom: 20px">Login</h2>
        <p>Welcome back to SWUTalk!</p>
        <div style="margin-top: 40px; text-align: center;">
            <a href="/auth/google" style="text-decoration: none;">
                <button type="button" style="background-color: #4285F4; border-radius: 4px; font-weight: bold; width: 100%;">
                    Sign in with Google (@g.swu.ac.th)
                </button>
            </a>
        </div>
        <div style="margin-top: 20px; text-align: center; color: #555;">
            <p>Only SWU accounts are supported.</p>
        </div>
    </div>
    
</body>
</html>
